{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:e2e:helpdesk": "node --test e2e/helpdesk-figma.e2e.test.mjs e2e/helpdesk-candidate-review.e2e.test.mjs e2e/helpdesk-data-charts.e2e.test.mjs e2e/helpdesk-faq-review.e2e.test.mjs",
    "test:e2e:boot": "vite build && node --test e2e/boot-guard.e2e.test.mjs",
    "test": "node --experimental-strip-types --import ./tests/support/register.mjs --test \"tests/**/*.test.ts\" \"tests/**/*.test.tsx\""
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@uiw/react-md-editor": "^4.1.2",
    "antd": "^5.29.3",
    "axios": "^1.20.0",
    "katex": "^0.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
