    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^28.1.0",
    "oxlint": "^1.81.0",
    "playwright": "^1.61.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
