/// FAQ 问题树的发布版本（快照写入后不再改；至多一行 published，部分唯一索引只在迁移里）
model HelpdeskFaqRelease {
  id            String    @id @db.Uuid
  version       Int       @unique(map: "helpdesk_faq_releases_version_key")
  /// draft | evaluating | published | rejected | superseded
  status        String
  snapshot      Json
  snapshotHash  String    @map("snapshot_hash")
  checks        Json
  evalReport    Json?     @map("eval_report")
  /// 当前（或最后一次）检查的 run；心跳停了 = 检查中断（迁移 20261103120000）
  evalRunId       String?   @map("eval_run_id") @db.Uuid
  evalStartedAt   DateTime? @map("eval_started_at") @db.Timestamptz(6)
  evalHeartbeatAt DateTime? @map("eval_heartbeat_at") @db.Timestamptz(6)
