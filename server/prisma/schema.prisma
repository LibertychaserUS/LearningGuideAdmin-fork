/// v5 Part G 数据飞轮（迁移 20261031090000_helpdesk_flywheel）：Admin 的事实表。Admin 读不到 Portal 的库，
/// 每一行都来自 Portal 的 insights 接口（学员文字已脱敏，其余是标签），按轮 id 幂等 upsert。
/// 指标视图 helpdesk_insight_turn_facts、CHECK、外键与部分索引只在迁移里（服务层用 SQL 读写，不经 Prisma）。
model HelpdeskInsightTurn {
  id                    String   @id @db.Uuid
  createdAt             DateTime @map("created_at") @db.Timestamptz(6)
  source                String?
  locale                String
  text                  String
  sessionId             String?  @map("session_id") @db.Uuid
  turnIndex             Int?     @map("turn_index") @db.SmallInt
  lastTurn              Boolean? @map("last_turn")
  sessionEndReason      String?  @map("session_end_reason")
  kind                  String?
  intent                String?
  guard                 String?
  via                   String?
  faqId                 String?  @map("faq_id") @db.Uuid
  nodeId                String?  @map("node_id") @db.Uuid
  parentNodeId          String?  @map("parent_node_id") @db.Uuid
  releaseVersion        Int?     @map("release_version")
  answered              Boolean  @default(false)
  vote                  String?
  rating                Int?     @db.SmallInt
  covered               Boolean?
  expanded              Boolean?
  handover              Boolean  @default(false)
  ticketAfterChat       Boolean  @default(false) @map("ticket_after_chat")
