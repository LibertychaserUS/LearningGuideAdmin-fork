// Learning Guide BackOffice — Prisma Schema
// 依据开发文档 §2《数据库模型设计（Prisma Schema）》逐字段照抄（v1.0）
// 任何表结构变更必须通过 Prisma Migrate 管理，禁止手改数据库

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 核心实体
// ==========================================

model User {
  id      String   @id @default(uuid())
  email   String   @unique
  name    String?
  courses Course[]
}

// 第一层：课程 (Course)
model Course {
  id               String   @id @default(uuid())
  title            String
  description      String?
  externalId       String? // 对应外部同步源的 ID
  structureJson    Json? // 存储树形目录的原始结构，用于快速渲染
  // 上线版本指针（§3.4.3/§4.3.3）：用户侧 AI Tutor 读此 Release 快照；普通标量列，不建 Prisma 外键关系
  currentReleaseId String?
  // 后台「测试所选 Release」（2026-10-20 新增）：AI Tutor 后台测试对话读此 Release 快照；null 时回退 currentReleaseId
  aiTestReleaseId  String?
  // 当前编辑版本指针（2026-10-20 二次改拍）：新建 Release 或「切换到此版本」后指向该 Release；历史弹窗 editing 标识来源；普通标量列，不建 Prisma 外键关系
  editingReleaseId String?
  // 课程级 Online 开关（2026-10-20 由 CourseAiConfig.online 搬移而来）：该课程 AI Tutor 是否对用户侧开放
  aiTutorOnline    Boolean  @default(false)
  // 商品课程关联（2026-10-26 新增）：KS 课程 ↔ CommerceCourse，一个商品课程最多对应一个 KS 课程
  commerceCourseId String?  @unique
  commerceCourse   CommerceCourse? @relation(fields: [commerceCourseId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  pages          Page[]
  releases       Release[]
  // 每个 Release 各一份 AI 配置（2026-10-20 由一对一改为按 Release 一对多）
  aiConfigs      CourseAiConfig[]
  // 反向关联：users 为隐式多对多，migrate 时生成联接表 _CourseToUser
  users          User[]
  aiChatSessions AiChatSession[]
}

// 第二层：页面/内容 (Page)（2026-10-16 扁平化：原 Lesson → Page 合并）
model Page {
  id          String    @id @default(uuid())
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  // Portal lesson.id（2026-10-22 新增）：标题同步的稳定匹配键；此前同步的页面可为空
  externalId  String?
  title       String // 原 Lesson 标题（md 文件标题）
  contentMd   String    @db.Text // 合并后的 Markdown：各原 Page 以 `# {Page标题}` 为 H1 拼接（Lesson.title 不入内容）
  sectionTags Json? // H1-H6 级标签映射：{ "h{n}-slug": ["tag1"] }（2026-10-16：移除页面级 tags）
  sortOrder   Int
  syncState   SyncState @default(SYNCED) // 外部源同步状态（§3.2.2）

  @@unique([courseId, externalId])
  @@index([courseId, sortOrder])
}

model KnowledgeImageAsset {
  id        String   @id @default(uuid()) @db.Uuid
  courseId  String
  storageKey String @unique
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([courseId])
}

// 全局 Tag 词库（2026-10-16 方案 B 轻量版：用户输入新 tag 自动沉淀，颜色自动分配）
model Tag {
  id    String @id @default(uuid())
  name  String @unique // tag 名称（唯一）
  color String // 预设语义色或自动分配色
}

// 同步状态枚举
enum SyncState {
  SYNCED // 与外部源一致
  STALE // 本地独有或外部已变更，已失效
}

// ==========================================
// 发布与版本控制
// ==========================================

model Release {
  id            String   @id @default(uuid())
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id])
  versionTag    String // 版本号，格式: "CourseName_YYYYMMDDHHmm"（精确到分钟）
  revisionNotes String   @db.Text // 本次修订的备注
  snapshotData  Json // 完整内容快照: { pages: [{ id, title, contentMd, sectionTags }] }（2026-10-16 扁平化；去 tags）
  createdAt     DateTime @default(now())

  // 反向关联：该 Release 对应的 AI 配置（2026-10-20 按 Release 一份）
  aiConfigs CourseAiConfig[]
  // 反向关联：该 Release 的知识库向量分块（RAG，2026-10-26 新增）
  knowledgeChunks KnowledgeChunk[]

  @@index([courseId, createdAt])
}

// ==========================================
// RAG 知识库向量分块（2026-10-26 新增）
// 发布 Release 时异步分块 + embedding，对话时按向量相似度检索
// ==========================================
model KnowledgeChunk {
  id          String   @id @default(uuid())
  releaseId   String
  release     Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  pageId      String?   // 原 Page ID（追溯用）
  pageTitle   String    // 页面标题（引用展示用）
  heading     String?   // 所属 H1-H6 标题（引用展示用）
  content     String   @db.Text   // 分块纯文本
  embedding   Unsupported("vector(1536)")  // pgvector 1536 维（text-embedding-3-small）
  sortOrder   Int       // 页面内顺序
  tokenCount  Int       // token 估算（上下文预算用）
  createdAt   DateTime  @default(now())

  @@index([releaseId])
  @@index([releaseId, sortOrder])
}

// ==========================================
// AI Tutor 配置模块
// ==========================================

// AI 提示词模板库（预设两套模式）
model PromptTemplate {
  id           String   @id @default(uuid())
  mode         String // 枚举: "LECTURE" | "SOCRATIC" | "ASSESSMENT"
  systemPrompt String   @db.Text // 系统提示词
  welcomeMsg   String   @db.Text // 欢迎语
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // 反向关联：被哪些课程引用
  // 注：CourseAiConfig 存在多条指向本模型的关系（Lecture/Socratic/Assessment），
  // Prisma 要求多关系必须命名消歧，故拆分为多个反向列表字段（不影响数据库列结构）
  lectureConfigs    CourseAiConfig[] @relation("LectureTemplate")
  socraticConfigs   CourseAiConfig[] @relation("SocraticTemplate")
  assessmentConfigs CourseAiConfig[] @relation("AssessmentTemplate")
}

// 课程 + 发布版本 专属的 AI 配置（2026-10-20 改拍：由「每课程一份」→「每个 Release 一份」）
// 2026-10-27 调整：System Prompt 按模式分开（Lecture/Socratic/Assessment），
//   Welcome Message 与 LLM Model 统一为课程级共享列（不随模式切换）。
model CourseAiConfig {
  id        String  @id @default(uuid())
  courseId  String
  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  releaseId String
  release   Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  // 引用基础模板（三条关系分别命名以消歧）
  lectureModeId      String?
  socraticModeId     String?
  assessmentModeId   String?
  lectureTemplate    PromptTemplate? @relation("LectureTemplate", fields: [lectureModeId], references: [id])
  socraticTemplate   PromptTemplate? @relation("SocraticTemplate", fields: [socraticModeId], references: [id])
  assessmentTemplate PromptTemplate? @relation("AssessmentTemplate", fields: [assessmentModeId], references: [id])

  // 主提示词（讲授/苏格拉底共享，置于拼接最前端；Assessment 不参与）
  // 2026-10-29 新增 mainSystemPrompt，用于承载不可协商的硬约束（身份/域界/拒答/注入防护/优先级）
  mainSystemPrompt String? @db.Text

  // 各模式自定义 System Prompt（按模式分开，可选；有值即优先于该模式模板）
  // 2026-10-27 新增 assessmentSystemPrompt；welcome 与 model 统一为共享列
  lectureSystemPrompt    String? @db.Text
  socraticSystemPrompt   String? @db.Text
  assessmentSystemPrompt String? @db.Text

  // 统一 Welcome Message（不再按模式分开）
  welcomeMsg String? @db.Text

  // LLM 配置（llmProvider / llmBaseUrl / apiKey / model 均课程级共享；model null 回退 AI_AVAILABLE_MODELS[0]）
  llmProvider String // 如: "openrouter"
  model       String?
  llmBaseUrl  String? // 可选的自定义 Base URL
  apiKey      String? // 加密存储

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 每个 Release 至多一份配置（2026-10-20 改拍；原 `courseId @unique` 已移除）
  @@unique([courseId, releaseId])
}

// 注：课程级 Online 开关已移至 Course.aiTutorOnline（2026-10-20）；无该 Release 的配置行时按模板默认值运行。

// AI 对话记录（后台调试用）
model AiChatSession {
  id        String   @id @default(uuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  messages  Json // 聊天记录: [{role: 'user'|'ai', content: string, createdAt: ISOString}]
  mode      String // 当前对话使用的模式: "LECTURE" | "SOCRATIC"
  createdAt DateTime @default(now())

  @@index([courseId, createdAt])
}

// AI 限流计数（2026-10-24）：多个 Agent 实例共用，见 src/ai/rate-limit.service.ts
model AiRateLimitHit {
  id    BigInt   @id @default(autoincrement())
  key   String
  hitAt DateTime @default(now()) @map("hit_at") @db.Timestamptz(6)

  @@index([key, hitAt])
  @@map("ai_rate_limit_hits")
}

// ==========================================
// BackOffice 员工身份（PRD v1.1 §3、§11；表结构见 migration 20261023150000_backoffice_employees）
// 业务读写走 src/backoffice/repositories 的原生 SQL（触发器与条件更新），这里只为 Prisma 声明表结构。
// ==========================================

model Employee {
  employeeId        String    @id @default(dbgenerated("gen_random_uuid()")) @map("employee_id") @db.Uuid
  loginEmail        String    @unique @map("login_email")
  role              String
  accountStatus     String    @default("ACTIVE") @map("account_status")
  emailVerification String    @default("PENDING_VERIFICATION") @map("email_verification")
  emailVerifiedAt   DateTime? @map("email_verified_at") @db.Timestamptz(6)
  passwordHash      String?   @map("password_hash")
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz(6)
  isBootstrapAdmin  Boolean   @default(false) @map("is_bootstrap_admin")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  sessions     EmployeeSession[]
  tokens       VerificationToken[]
  preferences  EmployeeUiPreference?
  actorEvents  AuditEvent[]          @relation("AuditActor")
  targetEvents AuditEvent[]          @relation("AuditTarget")

  @@index([role], map: "employees_role_idx")
  @@index([accountStatus, emailVerification], map: "employees_status_idx")
  @@map("employees")
}

model EmployeeSession {
  sessionId  String    @id @default(dbgenerated("gen_random_uuid()")) @map("session_id") @db.Uuid
  employeeId String    @map("employee_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")

  employee Employee @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade, onUpdate: NoAction)

  @@map("employee_sessions")
}

/// BackOffice 限流计数（登录、找回密码、发信），多实例共用；固定窗口
model BackofficeRateLimit {
  key      String   @id
  count    Int
  resetsAt DateTime @map("resets_at") @db.Timestamptz(6)

  @@index([resetsAt], map: "backoffice_rate_limits_resets_at_idx")
  @@map("backoffice_rate_limits")
}

model VerificationToken {
  tokenId    String    @id @default(dbgenerated("gen_random_uuid()")) @map("token_id") @db.Uuid
  employeeId String    @map("employee_id") @db.Uuid
  purpose    String
  tokenHash  String    @unique @map("token_hash")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  employee Employee @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade, onUpdate: NoAction)

  @@index([employeeId, purpose], map: "verification_tokens_employee_idx")
  @@map("verification_tokens")
}

model AuditEvent {
  eventId          BigInt   @id @default(autoincrement()) @map("event_id")
  eventName        String   @map("event_name")
  actorEmployeeId  String?  @map("actor_employee_id") @db.Uuid
  targetEmployeeId String?  @map("target_employee_id") @db.Uuid
  action           String
  oldValue         String?  @map("old_value")
  newValue         String?  @map("new_value")
  result           String
  ipAddress        String?  @map("ip_address")
  requestId        String?  @map("request_id")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor  Employee? @relation("AuditActor", fields: [actorEmployeeId], references: [employeeId], onDelete: SetNull, onUpdate: NoAction)
  target Employee? @relation("AuditTarget", fields: [targetEmployeeId], references: [employeeId], onDelete: SetNull, onUpdate: NoAction)

  @@index([targetEmployeeId, createdAt(sort: Desc)], map: "audit_events_target_idx")
  @@index([eventName, createdAt(sort: Desc)], map: "audit_events_name_idx")
  @@map("audit_events")
}

model EmployeeUiPreference {
  employeeId   String   @id @map("employee_id") @db.Uuid
  locale       String   @default("en-GB")
  sidebarState String   @default("expanded") @map("sidebar_state")
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  employee Employee @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade, onUpdate: NoAction)

  @@map("employee_ui_preferences")
}

model BackofficeSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("backoffice_settings")
}

// ==========================================
// HelpDesk Common Questions（2026-10-28，Figma addendum §A；迁移 20261028090000_helpdesk_questions）
// v2（2026-10-29）起不再使用：由下面的 helpdesk_faqs 取代。表原样保留、不搬数据，之后单独清理
// （运维文档 docs/Learning_Guide_BackOffice_Agent_Development_Document.md §4A.7）。
// ==========================================

model HelpdeskQuestion {
  id        String   @id @db.Uuid
  locale    String
  category  String
  question  String
  answer    String
  keywords  String[] @default([])
  status    String   @default("draft")
  featured  Boolean  @default(false)
  sortOrder Int      @default(0) @map("sort_order")
  version   Int      @default(1)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  revisions HelpdeskQuestionRevision[]

  @@index([locale, status, sortOrder], map: "helpdesk_questions_list_idx")
  @@index([keywords], map: "helpdesk_questions_keywords_idx", type: Gin)
  @@map("helpdesk_questions")
}

model HelpdeskQuestionRevision {
  id         String   @id @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  version    Int
  snapshot   Json
  action     String
  employeeId String?  @map("employee_id") @db.Uuid
  at         DateTime @default(now()) @db.Timestamptz(6)

  question HelpdeskQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([questionId, version], map: "helpdesk_question_revisions_question_version_key")
  @@map("helpdesk_question_revisions")
}

// HelpDesk 推荐日志（迁移 20261028090100_helpdesk_suggestions；v2 迁移 20261029090000_helpdesk_faqs
// 加 faq_id / source、category 可空、outcome 加 helpful / not_helpful）。归 Agent（src/ai/helpdesk）；
// faqId 指向 helpdesk_faqs，跨域不建外键；qaId 是 v1 的旧列（指向 helpdesk_questions），不再写入。
model HelpdeskSuggestion {
  id           String   @id @db.Uuid
  learnerId    String   @map("learner_id")
  locale       String
  category     String?
  source       String   @default("submit")
  queryText    String?  @map("query_text")
  candidateIds String[] @default([]) @map("candidate_ids") @db.Uuid
  qaId         String?  @map("qa_id") @db.Uuid
  faqId        String?  @map("faq_id") @db.Uuid
  model        String?
  latencyMs    Int      @default(0) @map("latency_ms")
  outcome      String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  // v5（迁移 20261030160000_helpdesk_suggestion_turns）：请求带 context 的一轮；CHECK 与部分索引只在迁移里
  kind           String?
  intent         String?
  confidence     String?
  nodeId         String?  @map("node_id") @db.Uuid
  blocks         String[] @default([])
  guardResult    String?  @map("guard_result")
  guardReason    String?  @map("guard_reason")
  guardFallback  String[] @default([]) @map("guard_fallback")
  covered        Boolean?
  sessionId      String?  @map("session_id") @db.Uuid
  releaseVersion Int?     @map("release_version")

  @@index([qaId])
  @@index([faqId])
  @@index([createdAt])
  @@map("helpdesk_suggestions")
}

// HelpDesk Agent 链路追踪（迁移 20261029120000_helpdesk_agent_events；helpdesk-agent-v2-pi-dsh §2）：
// dsh SessionEvent 日志，归 Agent（src/ai/helpdesk/trace）。只追加：seq 由应用在 run 级锁内分配，
// 触发器拒绝 DELETE 与除 90 天清学员原文以外的 UPDATE；parentRunId 表达式索引只在迁移里。
model HelpdeskAgentEvent {
  runId String   @map("run_id") @db.Uuid
  seq   Int
  type  String
  time  DateTime @db.Timestamptz(6)
  data  Json     @default("{}")

  @@id([runId, seq])
  @@index([time])
  @@map("helpdesk_agent_events")
}

// HelpDesk FAQ（Tickets v2 Figma addendum §1；迁移 20261029090000_helpdesk_faqs）：一条中英双语记录，
// 归 BackOffice（唯一写入方，原生 SQL 读写，见 modules/helpdesk/faqs/faqRepository.ts）。
// 英文全文 GIN 索引（helpdesk_faqs_search_en_idx）是表达式索引，Prisma 表达不了，只在迁移里。
model HelpdeskFaq {
  id             String   @id @db.Uuid
  category       String
  popular        Boolean  @default(false)
  /// 热门里的顺序（1 最前，null 没排）；迁移 20261102120000
  popularRank    Int?     @map("popular_rank")
  questionEn     String   @map("question_en")
  answerEn       String   @map("answer_en")
  questionZh     String   @map("question_zh")
  answerZh       String   @map("answer_zh")
  keywords       String[] @default([])
  /// v5 Part A：学员情境信号标签（FAQ_SIGNALS；迁移 20261030140000_helpdesk_faq_signals）
  signals        String[] @default([])
  /// v5 问题树（迁移 20261030150000_helpdesk_faq_graph）：稳定的 slug（不给时触发器按英文问题取）
  key            String   @unique(map: "helpdesk_faqs_key_key")
  /// answer | choice
  nodeType       String   @default("answer") @map("node_type")
  /// 能否被新问题直接命中
  entry          Boolean  @default(true)
  /// 问法的检索文字（helpdesk_faq_phrasings 的触发器维护；phrasing_tsv 是生成列，不在 Prisma 里）
  phrasingText   String   @default("") @map("phrasing_text")
  status         String   @default("published")
  version        Int      @default(1)
  idempotencyKey String?  @unique @map("idempotency_key") @db.Uuid
  createdBy      String?  @map("created_by") @db.Uuid
  updatedBy      String?  @map("updated_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  revisions HelpdeskFaqRevision[]
  reviews   HelpdeskFaqReview[]
  childEdges  HelpdeskFaqEdge[]     @relation("HelpdeskFaqEdgeParent")
  parentEdges HelpdeskFaqEdge[]     @relation("HelpdeskFaqEdgeChild")
  phrasings   HelpdeskFaqPhrasing[]
  placements  HelpdeskFaqPlacement[]

  @@index([status, popular(sort: Desc), updatedAt(sort: Desc)], map: "helpdesk_faqs_list_idx")
  @@index([keywords], map: "helpdesk_faqs_keywords_idx", type: Gin)
  @@map("helpdesk_faqs")
}

model HelpdeskFaqRevision {
  id         String   @id @db.Uuid
  faqId      String   @map("faq_id") @db.Uuid
  version    Int
  snapshot   Json
  action     String
  employeeId String?  @map("employee_id") @db.Uuid
  at         DateTime @default(now()) @db.Timestamptz(6)
  /// 写入流水线的改动号（缺省取本事务的 helpdesk.change_id；不经流水线 = NULL）
  changeId   String?  @default(dbgenerated("helpdesk_current_change_id()")) @map("change_id") @db.Uuid

  faq HelpdeskFaq @relation(fields: [faqId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([faqId, version], map: "helpdesk_faq_revisions_faq_version_key")
  @@index([at], map: "helpdesk_faq_revisions_at_idx")
  @@map("helpdesk_faq_revisions")
}

