  AWAITING_CONFIRM
  IMPORTING
  EXPORTING
  READY
  FAILED
  CANCELLED
}

model CommerceCourse {
  id                     String                @id @default(uuid())
  code                   String                @unique
  slug                   String                @unique
  categoryId             String?
  category               CourseCatalogueEntry? @relation("CourseCategory", fields: [categoryId], references: [id])
  subjectId              String?
  subject                CourseCatalogueEntry? @relation("CourseSubject", fields: [subjectId], references: [id])
  learningMode           LearningMode
  defaultContentLanguage String                @default("en-GB")
  learningLanguages      Json
  coverAssetId           String?                @unique
  cover                  CourseMediaAsset?     @relation("CourseCover", fields: [coverAssetId], references: [id])

  lifecycleStatus        CourseLifecycleStatus @default(WORKING)
  liveStatus             CourseLiveStatus      @default(HIDDEN)
  liveVersionId          String?
  currentUatVersionId    String?
  approvedAt             DateTime?
  approvedBy             String?
  lastUatPublishedAt     DateTime?
  archivedAt             DateTime?

  // P1b：草稿标记与来源（编辑/导入/恢复都只改草稿）
  hasDraft               Boolean               @default(false)
  draftSourceType        String?
  draftSourceEnvironment String?
  draftSourceVersionLabel String?
  trialEnabled           Boolean               @default(false)

  // v1 兼容 / 迁移过渡
  subtitle               String?
  level                  String?
  tags                   Json?
  referencePrice         Int?
  discount               Int?
  legacyCategory         String?
  legacyAuthorIds        Json?

  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  localizations CourseLocalization[]
  lessons       Lesson[]
  versions      CourseVersion[]
  media         CourseMediaAsset[]            @relation("CourseMedia")
  trialRows     TrialSetting[]
  authors       CommerceCourseAuthor[]
  plans         CoursePlan[]
  ksCourse      Course?

  @@index([lifecycleStatus, updatedAt])
  @@index([liveStatus])
  @@index([categoryId])
}

model CourseLocalization {
  id               String         @id @default(uuid())
  courseId         String
  course           CommerceCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  language         String
  title            String
  shortDescription String?
  overview         String?        @db.Text
  whatYouLearn     Json?
  provides         Json?

  @@unique([courseId, language])
}

model Lesson {
  id                 String         @id @default(uuid())
  courseId           String
  course             CommerceCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  code               String
  sortOrder          Int
  legacySectionId    String?
  legacySectionTitle String?
  archivedAt         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  localizations   LessonLocalization[]
  exhibits        Exhibit[]
  readings        RecommendedReading[]
  questions       KnowledgeQuestion[]
  applicationTest ApplicationTest?
  learningPoints  LearningPoint[]
  triggers        ExhibitTrigger[]

  @@unique([courseId, code])
  @@index([courseId, sortOrder])
}

model LessonLocalization {
  id                   String           @id @default(uuid())
  lessonId             String
  lesson               Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  language             String
  title                String
  description          String?
  videoAssetId         String?
  video                CourseMediaAsset? @relation("LessonVideo", fields: [videoAssetId], references: [id])
  videoDurationSeconds Int?
  textHtml             String?          @db.Text
  textLearningPoints   Json?
  legacyContents       Json?

  @@unique([lessonId, language])
}

model Exhibit {
  id               String           @id @default(uuid())
  lessonId         String
  lesson           Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  code             String
  type             ExhibitType
  mediaAssetId     String?
  media            CourseMediaAsset? @relation("ExhibitMedia", fields: [mediaAssetId], references: [id])
  thumbnailAssetId String?
  thumbnail        CourseMediaAsset? @relation("ExhibitThumbnail", fields: [thumbnailAssetId], references: [id])
  sourceText       String?
  localized        Json
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([lessonId, code])
}

model LearningPoint {
  id            String              @id @default(uuid())
  lessonId      String
  lesson        Lesson              @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  language      String
  code          String
  title         String
  source        LearningPointSource
  timeSeconds   Int?
  anchorHeading String?
  sortOrder     Int

  @@unique([lessonId, language, code])
}

model ExhibitTrigger {
  id          String @id @default(uuid())
  lessonId    String
  lesson      Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  exhibitId   String
  language    String
  timeSeconds Int

  @@unique([lessonId, exhibitId, language])
}

model RecommendedReading {
  id             String      @id @default(uuid())
  lessonId       String
  lesson         Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  language       String
  type           ReadingType
  title          String
  author         String?
  whyRecommended String?     @db.Text
  sortOrder      Int

  @@index([lessonId, language, sortOrder])
}

model KnowledgeQuestion {
  id              String  @id @default(uuid())
  lessonId        String
  lesson          Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  code            String
  question        String  @db.Text
  referenceAnswer String? @db.Text
  sortOrder       Int
  enabled         Boolean @default(true)

  @@unique([lessonId, code])
}

model ApplicationTest {
  id              String  @id @default(uuid())
  lessonId        String  @unique
  lesson          Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  scenario        String  @db.Text
  referenceAnswer String? @db.Text
  enabled         Boolean @default(true)
}

model TrialSetting {
  id                        String         @id @default(uuid())
  courseId                  String
  course                    CommerceCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId                  String
  videoCutoffSeconds        Int?
  textCutoffLearningPointId String?
  // 按学习语言分别保存截止点（PRD §14）；旧字段保留兼容单语言数据
  videoCutoffByLanguage     Json?
  textCutoffByLanguage      Json?
  // Re-confirm 判定基线：确认时所在课时的视频与文本截止点
  confirmedVideoAssetId     String?
  confirmedTextCutoffCode   String?
  status                    TrialRowStatus @default(LOCKED)
  updatedAt                 DateTime       @updatedAt

  @@unique([courseId, lessonId])
}

model CourseVersion {
  id                  String         @id @default(uuid())
  courseId            String
  course              CommerceCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  versionNo           Int
  versionLabel        String         @default("")
  versionSeries       Int            @default(1)
  versionMinor        Int            @default(1)
  sourceVersionId     String?
  sourceEnvironment   String?
  sourceVersionLabel  String?
  snapshotData        Json
  wentLiveAt          DateTime?
  exportedAt          DateTime?
  exportedBy          String?        @db.Uuid
  createdBy           String?
  createdAt           DateTime       @default(now())

  @@unique([courseId, versionNo])
  @@index([courseId, wentLiveAt])
}

model CourseMediaAsset {
  id           String          @id @default(uuid())
  courseId     String
  course       CommerceCourse  @relation("CourseMedia", fields: [courseId], references: [id], onDelete: Cascade)
  kind         CourseMediaKind
  originalName String
  mimeType     String
  extension    String
  size         Int
  storageKey   String          @unique
  checksum     String?
  createdBy    String?
  createdAt    DateTime        @default(now())

  coverFor         CommerceCourse?    @relation("CourseCover")
  exhibitMedia     Exhibit[]          @relation("ExhibitMedia")
  exhibitThumbnail Exhibit[]          @relation("ExhibitThumbnail")
  lessonVideos     LessonLocalization[] @relation("LessonVideo")

  @@index([courseId, kind])
}

model CourseCatalogueEntry {
  id          String                 @id @default(uuid())
  name        String
  description String                 @default("")
  parentId    String?
  parent      CourseCatalogueEntry?  @relation("CatalogueParent", fields: [parentId], references: [id])
  children    CourseCatalogueEntry[] @relation("CatalogueParent")
  status      CatalogueStatus        @default(ACTIVE)
  sortOrder   Int                    @default(0)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  coursesAsCategory CommerceCourse[] @relation("CourseCategory")
  coursesAsSubject  CommerceCourse[] @relation("CourseSubject")

  @@unique([parentId, name])
  @@index([parentId, sortOrder])
}

model CoursePlan {
  id              String          @id
  courseId        String?
  course          CommerceCourse? @relation(fields: [courseId], references: [id])
  name            String
  scope           String
  scopeId         String
  termMonths      Int
  device          String
  amountMinor     Int
  currency        String          @default("usd")
  stripeLookupKey String?
  stripeProductId String?
  stripePriceId   String?
  lastSyncedAt    DateTime?
  syncError       String?
  active          Boolean         @default(true)
  sortOrder       Int             @default(0)
  aiPoints        Int             @default(0)
  trialEligible   Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([scope, scopeId])
}

model CommerceCourseAuthor {
  courseId   String
  course     CommerceCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  employeeId String         @db.Uuid
  createdAt  DateTime       @default(now())

  @@id([courseId, employeeId])
  @@index([employeeId])
}

model CourseAuthoringActivity {
  id              BigInt   @id @default(autoincrement())
  courseId        String?
  versionNo       Int?
  actorEmployeeId String?  @db.Uuid
  action          String
  detail          Json?
  requestId       String?
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  @@index([courseId, createdAt(sort: Desc)])
}

model PopularCourseEntry {
  id        String         @id @default(uuid())
  courseId  String         @unique
  sortOrder Int
  createdAt DateTime       @default(now())

  @@index([sortOrder])
}

model DiscoveryBanner {
  id          String   @id @default("singleton")
  enabled     Boolean  @default(false)
  courseId    String?
  localized   Json?
  publishedAt DateTime?
  publishedBy String?  @db.Uuid
  updatedAt   DateTime @updatedAt
}

/** Popular Courses 运营位的发布状态（与 Discovery Banner 各自 Publish）。 */
model PopularCoursesState {
  id          String   @id @default("singleton")
  publishedAt DateTime?
  publishedBy String?  @db.Uuid
  updatedAt   DateTime @updatedAt
}

model CoursePackageJob {
  id              String                 @id @default(uuid())
  kind            CoursePackageJobKind
  status          CoursePackageJobStatus @default(UPLOADING)
  courseId        String?
  actorEmployeeId String?                @db.Uuid
  idempotencyKey  String?                @unique
  packageHash     String?
  sourceFileName  String?
  sourceVersionId String?
  fileLabel       String?
  bytesTotal      Int?
  bytesReceived   Int?                   @default(0)
  stage           String?
  progress        Int?                   @default(0)
  manifest        Json?
  report          Json?
  conflicts       Json?
  storageKey      String?
  error           String?
  lockedBy        String?
  lockedAt        DateTime?
  heartbeatAt     DateTime?
  attempts        Int                    @default(0)
  cancelRequested Boolean                @default(false)
  nextAttemptAt   DateTime?
  requestId       String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([kind, status, createdAt])
  @@index([actorEmployeeId, createdAt])
}

/// 写入流水线的改动记录（迁移 20261109000000_helpdesk_faq_change_pipeline）：一次命令一行，只追加；
/// 同时是发件箱，消费者按 seq 往后读。读写见 pipeline/faqCommandBus.ts（原生 SQL）。
model HelpdeskFaqChange {
  id         String   @id @db.Uuid
  seq        BigInt   @unique(map: "helpdesk_faq_changes_seq_key") @default(autoincrement())
  command    String
  /// human:<employeeId> | process:<name> | <tool>/<version>
  actor      String
  employeeId String?  @map("employee_id") @db.Uuid
  /// ui | import | flywheel | rewrite | seed | release | system
  causeKind  String   @map("cause_kind")
  causeRef   String?  @map("cause_ref")
  note       String?
  traceId    String?  @map("trace_id")
  summary    Json     @default("{}")
  at         DateTime @default(now()) @db.Timestamptz(6)

  @@index([at], map: "helpdesk_faq_changes_at_idx")
  @@map("helpdesk_faq_changes")
}

/// 所有写入命令共用的幂等记录：同键同请求 = 原样返回；同键不同请求 = 422
model HelpdeskIdempotency {
  command     String
  key         String   @db.Uuid
  actor       String
  requestHash String   @map("request_hash")
  result      Json
  changeId    String?  @map("change_id") @db.Uuid
  at          DateTime @default(now()) @db.Timestamptz(6)

  @@id([command, actor, key], map: "helpdesk_idempotency_pkey")
  @@index([at], map: "helpdesk_idempotency_at_idx")
  @@map("helpdesk_idempotency")
}
